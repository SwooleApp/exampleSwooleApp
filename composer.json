{
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "sidalex/swoole-app": "*",
    "ext-redis": "*"
  },
  "config": {
    "allow-plugins": {
      "yurunsoft/composer-include-files": true,
      "yurunsoft/guzzle-swoole": true
    }
  },
  "require-dev": {
    "codeception/codeception": "^5.3",
    "codeception/module-asserts": "^3.3",
    "codeception/module-phpbrowser": "^4.0",
    "codeception/module-rest": "^3.4"
  }
}
